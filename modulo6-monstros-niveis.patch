+## Tamanho do sprite no retrato do inimigo durante o combate (1 = tamanho
+## original). 0 = automático: o combate mede o desenho e ajusta ao retrato.
+@export var escala_combate: float = 0.0
+
+
+## Área ocupada pelo desenho (sem a margem transparente) no primeiro quadro de
+## "idle", em coordenadas locais do monstro (já considera o flip_h). Rect2()
+## vazio se não for possível medir.
+func area_visivel() -> Rect2:
+	var spr := get_node_or_null("AnimatedSprite2D") as AnimatedSprite2D
+	if spr == null or spr.sprite_frames == null or not spr.sprite_frames.has_animation(&"idle"):
+		return Rect2()
+	var tex := spr.sprite_frames.get_frame_texture(&"idle", 0)
+	if tex == null:
+		return Rect2()
+	var img := tex.get_image()
+	if img == null:
+		return Rect2()
+	var usado := img.get_used_rect()
+	if usado.size == Vector2i.ZERO:
+		return Rect2()
+	var centro := Vector2(img.get_size()) / 2.0
+	var r := Rect2(Vector2(usado.position) - centro, Vector2(usado.size))
+	if spr.flip_h:
+		r.position.x = -(r.position.x + r.size.x)
+	return Rect2(r.position + spr.position, r.size)
+
