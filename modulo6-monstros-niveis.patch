+## Ajusta tamanho e posição da criatura ao retrato: mede o desenho (sem a
+## margem transparente), escala para caber (em passos inteiros quando ≥ 2, para
+## manter os pixels nítidos), centraliza na horizontal e apoia os pés na base.
+func _encaixar_monstro(retrato: Control) -> void:
+	if _monstro == null:
+		return
+	var area := _monstro.area_visivel()
+	var escala := _monstro.escala_combate
+	if area.size.x <= 0.0 or area.size.y <= 0.0:
+		if escala <= 0.0:
+			escala = 1.5
+		_monstro.scale = Vector2.ONE * escala
+		_monstro.position = retrato.size * Vector2(0.5, 0.5)
+		return
+	if escala <= 0.0:
+		escala = minf(retrato.size.y * MONSTRO_ALTURA_MAX / area.size.y, retrato.size.x * MONSTRO_LARGURA_MAX / area.size.x)
+		escala = clampf(escala, 0.5, 4.0)
+		if escala >= 2.0:
+			escala = floorf(escala)
+	_monstro.scale = Vector2.ONE * escala
+	var centro_x := (area.position.x + area.size.x * 0.5) * escala
+	var base_y := (area.position.y + area.size.y) * escala
+	_monstro.position = Vector2(retrato.size.x * 0.5 - centro_x, retrato.size.y * MONSTRO_BASE - base_y)
+
+
