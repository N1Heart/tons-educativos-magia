+# ---------------------------------------------------------- criatura (PvE)
+
+## Escolhe a criatura pelo nível (no PvE em equipe, pela rodada, para todos da
+## equipe verem a mesma) e coloca o sprite no retrato do inimigo.
+func _montar_monstro() -> void:
+	var semente := -1
+	if _em_rede:
+		semente = DueloRede.rodada * 31 + maxi(0, DueloRede.grupo)
+	var escolhida := MonsterCatalog.escolher(_nivel, semente)
+	if escolhida.is_empty():
+		return
+	_monstro = (escolhida["cena"] as PackedScene).instantiate() as Monster
+	var retrato := $HUD/EnemyPanel/Portrait as Control
+	retrato.add_child(_monstro)
+	_monstro.scale = Vector2.ONE * _monstro.escala_combate
+	var centralizar := func(): _monstro.position = retrato.size * Vector2(0.5, 0.5)
+	retrato.resized.connect(centralizar)
+	centralizar.call()
+	_spr_monstro = _monstro.get_node_or_null("AnimatedSprite2D") as AnimatedSprite2D
+	if _spr_monstro != null and _spr_monstro.sprite_frames != null:
+		var frames := _spr_monstro.sprite_frames
+		for anim in [&"ataque", &"dano", &"morte"]:
+			if frames.has_animation(anim):
+				frames.set_animation_loop(anim, false)  # volta ao idle (ou fica na última pose)
+		_spr_monstro.animation_finished.connect(_on_anim_monstro_fim)
+		_tocar_monstro(&"idle")
+	($HUD/EnemyPanel/NameLabel as Label).text = _monstro.nome_exibicao.capitalize()
+
+
+func _tocar_monstro(anim: StringName) -> void:
+	if _spr_monstro == null or _spr_monstro.sprite_frames == null or _monstro_morto:
+		return
+	if not _spr_monstro.sprite_frames.has_animation(anim):
+		return
+	if anim == &"morte":
+		_monstro_morto = true
+	_spr_monstro.speed_scale = ESCALA_ANIM.get(anim, 1.0)
+	_spr_monstro.play(anim)
+
+
+func _on_anim_monstro_fim() -> void:
+	if not _monstro_morto:
+		_tocar_monstro(&"idle")
+
+
+## Reage às mudanças de HP: o monstro leva dano, ataca quando o time perde vida
+## e morre quando a vida acaba. Vale para todos os jogadores da equipe, já que
+## todos recebem as mesmas atualizações de HP.
+func _animar_monstro(player_units: Array, enemy_units: Array) -> void:
+	if _spr_monstro == null:
+		return
+	var hp_inimigo := 0
+	for u in enemy_units:
+		hp_inimigo += u.current_hp
+	var hp_time := 0
+	for u in player_units:
+		hp_time += u.current_hp
+	if _hp_inimigo_antes >= 0:
+		if hp_inimigo <= 0 and _hp_inimigo_antes > 0:
+			_tocar_monstro(&"morte")
+		elif hp_inimigo < _hp_inimigo_antes:
+			_tocar_monstro(&"dano")
+		elif hp_time < _hp_time_antes:
+			_tocar_monstro(&"ataque")
+	_hp_inimigo_antes = hp_inimigo
+	_hp_time_antes = hp_time
 
 
