diff --git a/entities/Porta.gd b/entities/Porta.gd
new file mode 100644
index 0000000..e5af081
--- /dev/null
+++ b/entities/Porta.gd
@@ -0,0 +1,23 @@
+extends Area2D
+
+## Porta/transição entre salas: qualquer corpo do grupo "jogador" que entrar
+## nesta área troca de cena para `cena_destino`.
+##
+## O ColorRect + Label dentro da cena só existem para ficar visível no editor
+## enquanto as salas não têm portas desenhadas no tilemap — pode esconder ou
+## apagar esse visual depois, a lógica de transição não depende dele.
+## Arraste este nó (ou a instância dele) para a posição correta de cada sala.
+
+@export_file("*.tscn") var cena_destino: String = ""
+
+
+func _ready() -> void:
+	body_entered.connect(_on_body_entered)
+
+
+func _on_body_entered(body: Node) -> void:
+	if cena_destino == "":
+		push_warning("Porta sem cena_destino configurada: %s" % get_path())
+		return
+	if body.is_in_group("jogador"):
+		get_tree().change_scene_to_file(cena_destino)
