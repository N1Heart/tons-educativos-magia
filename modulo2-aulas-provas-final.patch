+        "pergunta": "A soma dos ângulos internos de um hexágono é 540°.",
+        "alternativas": [],
+        "respostaCorreta": "Falso",
+        "explicacao": "É 720°: (6 − 2) × 180°. 540° é a soma do pentágono."
+      },
