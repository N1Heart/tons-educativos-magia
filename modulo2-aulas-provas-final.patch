+        "pergunta": "O triângulo equilátero tem dois lados iguais e um lado diferente.",
+        "alternativas": [],
+        "respostaCorreta": "Falso",
+        "explicacao": "Esse é o isósceles. No equilátero, os três lados são iguais."
+      },
+      {
+        "tipo": "vf",
+        "pergunta": "É possível desenhar um triângulo com dois ângulos retos.",
+        "alternativas": [],
+        "respostaCorreta": "Falso",
+        "explicacao": "Dois ângulos de 90° já somam 180°, sem sobrar nada para o terceiro ângulo."
+      },
+      {
+        "tipo": "vf",
+        "pergunta": "Com varetas de 2 cm, 3 cm e 10 cm é possível montar um triângulo.",
+        "alternativas": [],
+        "respostaCorreta": "Falso",
+        "explicacao": "2 + 3 = 5, que é menor que 10. A desigualdade triangular não é respeitada."
+      },
+      {
+        "tipo": "objetiva",
+        "pergunta": "Qual é a área de um triângulo com base 10 cm e altura 6 cm?",
+        "alternativas": [
+          "16 cm²",
+          "30 cm²",
+          "60 cm²",
+          "36 cm²"
+        ],
+        "respostaCorreta": "30 cm²",
+        "explicacao": "A = (10 × 6) ÷ 2 = 30 cm²."
+      },
+      {
+        "tipo": "objetiva",
+        "pergunta": "Como se chama o triângulo que possui um ângulo de 90°?",
+        "alternativas": [
+          "Acutângulo",
+          "Obtusângulo",
+          "Equilátero",
+          "Retângulo"
+        ],
+        "respostaCorreta": "Retângulo",
+        "explicacao": "Triângulo retângulo é o que possui um ângulo reto (90°)."
+      },
+      {
+        "tipo": "objetiva",
+        "pergunta": "Em um triângulo retângulo, os catetos medem 3 cm e 4 cm. Quanto mede a hipotenusa?",
+        "alternativas": [
+          "5 cm",
+          "7 cm",
+          "12 cm",
+          "25 cm"
+        ],
+        "respostaCorreta": "5 cm",
+        "explicacao": "Pelo Teorema de Pitágoras: 3² + 4² = 25, e a raiz quadrada de 25 é 5."
+      },
+      {
+        "tipo": "objetiva",
+        "pergunta": "Por que engenheiros usam muitos triângulos em pontes e torres?",
+        "alternativas": [
+          "Porque são mais bonitos",
